{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "win-vs2022-x64",
      "displayName": "Windows x64 (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/vs2022-x64",
      "cacheVariables": {
        "CRAY_BUILD_TESTS": "ON",
        "CRAY_BUILD_STANDALONE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-vs2022-x64-release",
      "configurePreset": "win-vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "win-vs2022-x64-debug",
      "configurePreset": "win-vs2022-x64",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "win-vs2022-x64-test",
      "configurePreset": "win-vs2022-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
